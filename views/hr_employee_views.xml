<odoo>
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Si la page a un nom spécifique -->
            <page name="public" position="inside">
                <group string="Informations supplémentaires">
                    <field name="matriculepf"/>
                    <field name="employee_type"/>
                    <field name="blood_group"/>
                    <field name="qr_link"/>
                    <group attrs="{'invisible': [('employee_type','!=','apprentice')]}">
                        <field name="apprentice_start_date"/>
                        <field name="apprentice_end_date"/>
                    </group>
                </group>
            </page>
        </field>
    </record>
</odoo>